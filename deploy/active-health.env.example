# Copy to /etc/active-health/active-health.env; do not commit the real file.
DATABASE_URL=sqlite:////srv/active-health/shared/active_health.db
DATA_DIR=/srv/active-health/shared/data
UPLOAD_DIR=/srv/active-health/shared/uploads
AI_POSE_URL=http://127.0.0.1:8101
ALLOWED_ORIGINS=https://health.example.com
COOKIE_SECURE=true
ENABLE_DEMO_ACCOUNTS=false
RTMPOSE_BACKEND=onnxruntime
RTMPOSE_MODE=balanced
RTMPOSE_DEVICE=cpu
HOME=/srv/active-health/shared/home
XDG_CACHE_HOME=/srv/active-health/shared/cache
